# Copy this file to .env.local and fill in the values.
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The "publishable" key (the older "anon" key also works here). Never put the secret key in this file.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# AI writing for Pro accounts (server only; never prefix with NEXT_PUBLIC_).
# Any service that speaks the OpenAI chat format works. Free choices:
#   Google Gemini (default): key from https://aistudio.google.com/apikey
#   Groq: AI_BASE_URL=https://api.groq.com/openai/v1  AI_MODEL=llama-3.3-70b-versatile
# AI_MODEL can list several models, tried in order when one is busy.
# Leave AI_API_KEY empty to switch AI writing off.
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.1-flash-lite,gemini-flash-lite-latest

# Server-only Supabase key, used only by the payment webhook (Supabase: Project Settings -> API Keys -> secret key).
SUPABASE_SECRET_KEY=

# Paymob (Paymob dashboard -> Settings / Developers). Leave empty to keep payments switched off.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Integration IDs to offer, comma separated: for example card, mobile wallet and kiosk.
PAYMOB_INTEGRATION_IDS=
# Optional: integration IDs that accept US dollars. Empty means EGP only.
PAYMOB_USD_INTEGRATION_IDS=

# Shown on the terms, privacy and refund pages.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# The public address of the app, used in email links. Optional on Vercel (it knows its own address).
NEXT_PUBLIC_SITE_URL=

# Emails (resend.com, free tier): new-message alerts, receipts, "Pro ends soon" reminders.
# EMAIL_FROM must use a domain verified in Resend, for example: Portfolio Maker <hello@yourdomain.com>
# Leave empty to send no emails. Emails also need SUPABASE_SECRET_KEY (to look up account addresses).
RESEND_API_KEY=
EMAIL_FROM=

# Daily job (vercel.json): any long random string. Vercel sends it to /api/cron/daily by itself.
CRON_SECRET=

# Custom domains for Pro (Vercel -> Account settings -> Tokens; project -> Settings -> General).
# VERCEL_TEAM_ID only when the project belongs to a team. Leave empty to switch domains off.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
